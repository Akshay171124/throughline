# Copy to .env and fill in. Never commit .env.

# OpenAI: event credits are explained at the venue; keys live at https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Strong model for the one-time concept and edge extraction; fast model for the live agent
OPENAI_EXTRACT_MODEL=gpt-5.5
OPENAI_AGENT_MODEL=gpt-5.4-mini

# Bright Data: sign up at https://brightdata.com/cp/start, create an API key, redeem the event code
BRIGHTDATA_API_TOKEN=
# Zone name of the SERP API zone you create in the dashboard (used for outside explainers)
BRIGHTDATA_SERP_ZONE=
# Browser API (Scraping Browser) websocket endpoint, from that zone's dashboard page (used for the catalog)
BRIGHTDATA_BROWSER_WS=

# Hosted FalkorDB lab: paste the URL row from the lab page (falkors://falkordb:PASSWORD@HOST:PORT).
# Leave empty to use the local Docker instance below (the offline fallback).
FALKORDB_URL=
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
GRAPH_NAME=throughline

# The on-screen clock starts here: Wednesday 8:30 AM, day 1 of GitHub Universe 2026
CLOCK_START=2026-10-28T08:30
